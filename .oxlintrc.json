{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "react",
    "import",
    "unicorn",
    "jsx-a11y",
    "oxc"
  ],
  "env": {
    "browser": true
  },
  "ignorePatterns": ["src/routeTree.gen.ts"],
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ]
}
