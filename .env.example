# SQLite database file (default: ./data/subdue.db)
DATABASE_PATH=./data/subdue.db

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Public URL of the MCP endpoint (OAuth resource identifier)
MCP_RESOURCE_URL=http://localhost:3000/api/mcp
