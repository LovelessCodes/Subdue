# SQLite database file (default: ./data/frist.db)
DATABASE_PATH=./data/frist.db

# Folder with drizzle migrations, applied on server boot (default: ./drizzle)
MIGRATIONS_PATH=./drizzle

# Better Auth — all three are optional.
# The secret is generated on first boot and stored next to the database
# (e.g. data/secret). Set it to move the database without the secret file.
BETTER_AUTH_SECRET=
# Public URL of the instance. When empty it is derived from each request,
# so LAN names and localhost both work.
BETTER_AUTH_URL=
# Comma-separated origins allowed for authenticated requests. Defaults to *
# (any origin); narrow it if you expose Frist beyond your own network.
TRUSTED_ORIGINS=

# Public URL of the MCP endpoint (OAuth resource identifier)
MCP_RESOURCE_URL=http://localhost:3000/api/mcp

# HTTP port (default: 3000)
PORT=3000

# Social sign-in (optional). A provider activates when both its client ID and
# secret are set. Extras follow ${PROVIDER}_${KEY}: MICROSOFT_TENANT_ID,
# COGNITO_REGION, FACEBOOK_SCOPES, DISCORD_PERMISSIONS, … Environment
# variables take precedence over the /admin page.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# WebAuthn passkeys are bound to one hostname; set this behind a real domain
# (defaults to localhost, which only fits local use).
# PASSKEY_RP_ID=subs.example.com
